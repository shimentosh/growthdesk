# Where the Next.js /api proxy forwards to (the Nest API, which mounts everything under /v1).
API_URL=http://127.0.0.1:3601
# The operator console; /admin redirects there. Blank in development = http://localhost:3602.
ADMIN_APP_URL=

# Optional error reporting (Sentry or a compatible server). Blank = off.
# SENTRY_DSN is read by the server at runtime; NEXT_PUBLIC_SENTRY_DSN is compiled into the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
