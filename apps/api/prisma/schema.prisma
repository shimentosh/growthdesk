  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, providerCallId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@index([workspaceId, contactId])
}

model CallScript {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  body        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Automation, events, notifications ──────────────────────────────────────

model Workflow {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspaceId      String    @db.Uuid
  name             String
  description      String    @default("")
  enabled          Boolean   @default(false)
  trigger          String
  conditions       Json      @default("[]")
  actions          Json      @default("[]")
  requiresApproval Boolean   @default(false)
  runCount         Int       @default(0)
  lastRunAt        DateTime?
  createdById      String?   @db.Uuid
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([workspaceId, trigger, enabled])
}

enum WorkflowRunStatus {
  pending
  waiting_approval
  waiting
  running
  succeeded
  failed
  skipped
  canceled
}

model WorkflowRun {
  id           String            @id @default(uuid(7)) @db.Uuid
  workspaceId  String            @db.Uuid
  workflowId   String            @db.Uuid
  eventId      String            @db.Uuid
  status       WorkflowRunStatus @default(pending)
  subjectType  String            @default("")
  subjectId    String            @default("")
  actionIndex  Int               @default(0)
  resumeAt     DateTime?
  log          Json              @default("[]")
  error        String            @default("")
  attempts     Int               @default(0)
  approvedById String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  finishedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventId])
  @@index([status, resumeAt])
  @@index([workspaceId, createdAt])
  @@index([finishedAt])
}

/// Transactional outbox. Written in the same transaction as the change it
/// describes; the worker fans it out to workflows, webhooks and notifications.
model DomainEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  type         String
  subjectType  String    @default("")
  subjectId    String    @default("")
  actorId      String?   @db.Uuid
  payload      Json      @default("{}")
  occurredAt   DateTime  @default(now())
  dispatchedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, occurredAt])
  @@index([workspaceId, type, occurredAt])
  /// task.overdue lookups by subject across workspaces, and call.completed checks.
  @@index([type, subjectId])
}

model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  type        String
  title       String
  body        String    @default("")
  link        String    @default("")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
  @@index([createdAt])
}

// ─── Public API: keys, webhooks, idempotency ────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  /// The first characters of the key, shown so a person can tell keys apart.
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEndpoint {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @db.Uuid
  url            String
  description    String    @default("")
  secretSealed   String
  events         String[]
  enabled        Boolean   @default(true)
  /// Who created the endpoint or last pointed it at a new URL. When they leave the workspace (or are disabled) it is paused for review.
  createdById    String?   @db.Uuid
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  lastError      String    @default("")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @db.Uuid
  endpointId     String    @db.Uuid
  eventId        String    @db.Uuid
  eventType      String
  /// pending | succeeded | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  responseStatus Int?
  error          String    @default("")
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  key         String
  requestHash String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([createdAt])
}

// ─── AI ──────────────────────────────────────────────────────────────────────

model AiUsage {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @db.Uuid
  userId       String?  @db.Uuid
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cached       Boolean  @default(false)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model AiCache {
