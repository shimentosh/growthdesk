{
  "name": "@growthdesk/api",
  "version": "0.1.0",
  "private": true,
  "description": "Growthdesk REST API (NestJS) and background worker",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --path tsconfig.worker.json --entryFile worker",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node --enable-source-maps dist/scripts/seed.js",
    "db:seed:demo": "node --enable-source-maps dist/scripts/seed-demo.js",
    "db:seed:library": "node --enable-source-maps dist/scripts/seed-library.js",
    "admin:create": "node --enable-source-maps dist/scripts/create-admin.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@growthdesk/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.74.0",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dotenv": "18.0.6",
    "helmet": "8.3.0",
    "imapflow": "1.7.8",
    "ioredis": "6.0.0",
    "mailparser": "3.9.23",
    "nodemailer": "10.0.16",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "^7.0.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
