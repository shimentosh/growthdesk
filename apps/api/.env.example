# ─── Growthdesk API + worker ────────────────────────────────────────────────
# Copy to apps/api/.env (`pnpm bootstrap` does this and generates ENCRYPTION_KEY).
# Blank values are treated as unset.

NODE_ENV=development
# debug | log | warn | error
LOG_LEVEL=log
# json (one object per line, the production default) | pretty (the development default). Blank = by NODE_ENV.
LOG_FORMAT=
API_PORT=3601
# The API listens on loopback; browsers reach it through the web app's /api proxy.
API_HOST=127.0.0.1
# Where people open the app. Email links, tracking/unsubscribe links, OAuth and
# provider webhook URLs are built from it. Must be https in production.
PUBLIC_APP_URL=http://localhost:3600
# Optional: the API's own public URL, when it has one (e.g. https://api.example.com). Claude and
# other MCP clients connect to {PUBLIC_API_URL}/mcp; unset, to {PUBLIC_APP_URL}/api/mcp (docs/MCP.md).
# Also the OAuth issuer for MCP sign-in (claude.ai custom connectors, Claude Code); unset, {PUBLIC_APP_URL}/api.
PUBLIC_API_URL=
# Where platform staff open the operator console (apps/admin). Must be https in production.
ADMIN_APP_URL=http://localhost:3602
# Origins allowed to send cookie-authenticated writes (comma-separated).
# Default: the origins of PUBLIC_APP_URL and ADMIN_APP_URL. If you set it, list both.
ALLOWED_ORIGINS=
# How many proxies in front of the web app append to X-Forwarded-For (your TLS proxy: 1).
# The web app's own /api proxy does not count: it passes the header through unchanged.
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://growthdesk:growthdesk@127.0.0.1:5466/growthdesk
REDIS_URL=redis://127.0.0.1:6386
# 32 random bytes, base64: openssl rand -base64 32
# Seals mailbox passwords, OAuth tokens and provider secrets. Losing it makes them unreadable.
ENCRYPTION_KEY=

SESSION_DAYS=14
RATE_LIMIT_PER_MINUTE=600

# Platform transactional mail (verification, reset, invitations, notifications).
# Development points at Mailpit (http://localhost:8066). Production: any SMTP relay.
MAIL_FROM=Growthdesk <no-reply@growthdesk.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1066
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional: Google sign-in AND Gmail mailbox connections (OAuth client, web application).
# Redirect URIs: {PUBLIC_APP_URL}/api/auth/google/callback and {PUBLIC_APP_URL}/api/mailboxes/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Microsoft 365 mailbox connections (Entra app registration).
# Redirect URI: {PUBLIC_APP_URL}/api/mailboxes/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional: Stripe subscriptions. Without both, checkout reports itself unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI defaults (the platform admin can override provider/model/key in Settings).
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: another endpoint, e.g. an OpenAI-compatible gateway (https://host/v1). Leave blank for the provider default.
AI_BASE_URL=

# Worker
WORKER_CONCURRENCY=5
# Development only: lets mailboxes point at local test servers (GreenMail on 127.0.0.1). Never in production.
ALLOW_PRIVATE_MAIL_HOSTS=false
ALLOW_PRIVATE_WEBHOOKS=false

# Optional error reporting for the API and worker (Sentry or a compatible server). Blank = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Data retention in days for history tables, pruned daily at 03:20 UTC by the worker. Blank = default, 0 = keep.
# Defaults: domain events 30, message events 365, workflow runs 90, step executions 0 (kept),
# automated click entries on the timeline 365, AI usage 400, processed billing webhooks 400,
# marketing sends of campaigns finished 730 days ago. See docs/DEPLOYMENT.md → Data retention.
RETENTION_DOMAIN_EVENT_DAYS=
RETENTION_MESSAGE_EVENT_DAYS=
RETENTION_WORKFLOW_RUN_DAYS=
RETENTION_STEP_EXECUTION_DAYS=
RETENTION_ACTIVITY_NOISE_DAYS=
RETENTION_AI_USAGE_DAYS=
RETENTION_BILLING_EVENT_DAYS=
RETENTION_MARKETING_SEND_DAYS=
RETENTION_BATCH_SIZE=5000
# Account lifecycle and GDPR (docs/PRIVACY_OPS.md)
# Days a deleted workspace can be restored before the purge job hard-deletes it.
WORKSPACE_PURGE_DAYS=30
# Where workspace data exports are written; the API and the worker must share this directory.
DATA_EXPORT_DIR=.data/exports
# Days an export can be downloaded before it is deleted.
DATA_EXPORT_DAYS=7
