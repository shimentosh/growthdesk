# Used by docker-compose.prod.yml. Never commit the filled-in copy.
PUBLIC_APP_URL=https://app.example.com
# The operator console (the `admin` service). Put it on its own host behind your TLS proxy.
ADMIN_APP_URL=https://admin.example.com
# Optional: origins allowed to send cookie-authenticated writes (comma-separated).
# Default: the origins of PUBLIC_APP_URL and ADMIN_APP_URL — leave unset unless you need more.
ALLOWED_ORIGINS=
# Optional: the console's environment badge ("Production", "Staging", …). Default: guessed from the host.
ADMIN_ENV_LABEL=
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 32 — back it up: without it sealed secrets cannot be read.
ENCRYPTION_KEY=
MAIL_FROM=Growthdesk <no-reply@example.com>
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Backups (docs/DEPLOYMENT.md → Backups): nightly pg_dump into BACKUP_DIR. Copy that directory off this host.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=3
BACKUP_RETAIN_DAYS=14

# Logs (docs/DEPLOYMENT.md → Logs). The API and worker write JSON lines; Docker rotates them.
LOG_LEVEL=log
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Optional error reporting (Sentry, or a compatible server such as GlitchTip). Blank = off.
# SENTRY_DSN covers the API, the worker and the web server; NEXT_PUBLIC_SENTRY_DSN (usually the same DSN)
# is compiled into the browser bundle at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Data retention in days (docs/DEPLOYMENT.md → Data retention). Blank = the default; 0 = keep forever.
# Defaults: domain events 30, message events 365, workflow runs 90, step executions 0 (kept: the
# per-step campaign report reads them), automated click entries on the timeline 365, AI usage 400,
# processed billing webhooks 400, marketing sends of finished campaigns 730.
RETENTION_DOMAIN_EVENT_DAYS=
RETENTION_MESSAGE_EVENT_DAYS=
RETENTION_WORKFLOW_RUN_DAYS=
RETENTION_STEP_EXECUTION_DAYS=
RETENTION_ACTIVITY_NOISE_DAYS=
RETENTION_AI_USAGE_DAYS=
RETENTION_BILLING_EVENT_DAYS=
RETENTION_MARKETING_SEND_DAYS=

# Memory limits per container (docs/DEPLOYMENT.md → Resources). Raise them on a bigger host.
POSTGRES_MEMORY=2g
POSTGRES_SHM_SIZE=256mb
REDIS_MEMORY=512m
REDIS_MAXMEMORY=384mb
API_MEMORY=1g
WORKER_MEMORY=1g
WEB_MEMORY=768m
ADMIN_MEMORY=512m
