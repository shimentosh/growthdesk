# Used by docker-compose.prod.yml. Never commit the filled-in copy.
PUBLIC_APP_URL=https://app.example.com
# The operator console (the `admin` service). Put it on its own host behind your TLS proxy.
ADMIN_APP_URL=https://admin.example.com
# Optional: origins allowed to send cookie-authenticated writes (comma-separated).
# Default: the origins of PUBLIC_APP_URL and ADMIN_APP_URL — leave unset unless you need more.
ALLOWED_ORIGINS=
# Optional: the console's environment badge ("Production", "Staging", …). Default: guessed from the host.
ADMIN_ENV_LABEL=
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -base64 32 — back it up: without it sealed secrets cannot be read.
ENCRYPTION_KEY=
MAIL_FROM=Growthdesk <no-reply@example.com>
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Backups (docs/DEPLOYMENT.md → Backups): nightly pg_dump into BACKUP_DIR. Copy that directory off this host.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=3
BACKUP_RETAIN_DAYS=14
